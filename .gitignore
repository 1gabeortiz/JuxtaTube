# Dependencies — re-downloadable from package.json, never committed
node_modules/

# Build output
dist/
dist-ssr/

# Test coverage reports
coverage/

# Secrets — every .env file is ignored EXCEPT the blank .env.example template.
# Order matters: the negation must come after the pattern it carves out of.
.env*
!.env.example

# Vercel CLI local state
.vercel/

# Editor and OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
.vercel
.env*
