# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored; this file is committed as documentation only.

# --- Frontend (bundled into browser code — never put a secret here) ---
VITE_GOOGLE_CLIENT_ID=

# --- Backend only (read via process.env inside /api, never sent to the browser) ---
# YT_DATA_API_KEY - secret. API key from Google Cloud > Credentials.
# YT_CHANNEL_ID   - not secret. Public channel identifier, starts with "UC".
#                   Find it at https://www.youtube.com/account_advanced
YT_DATA_API_KEY=
YT_CHANNEL_ID=
GOOGLE_CLIENT_SECRET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
OAUTH_REDIRECT_URI=

# OWNER_ACCESS_KEY - secret. Any long random string of your choosing; it is not
#                    issued by anyone. Unlocks the private analytics routes, the
#                    owner-only writes, and keyword tag search. Generate one with:
#                      node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
OWNER_ACCESS_KEY=
